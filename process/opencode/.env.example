# opencode sandbox server env (copy to .env — never commit .env)
# HTTP basic auth for opencode serve; username defaults to "opencode"
OPENCODE_SERVER_PASSWORD=change-me

# provider credentials used by webfetch/sessions
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# optional default model override (provider/model-id)
#OPENCODE_MODEL=anthropic/claude-sonnet-4-5
