# ── Strategy ─────────────────────────────────────────────────────
KUCOIN_TIMEFRAME=4hour
RSI_PERIOD=21
RSI_LONG_THRESHOLD=60
RSI_SHORT_THRESHOLD=50
ATR_ENABLED=false
ATR_PERIOD=14
ATR_SL_MULTIPLIER=2.0
ATR_TP_MULTIPLIER=3.0
ATR_PCT_HIGH=5.0
ATR_HIGH_ADJUST=1.5
ATR_SL_MAX_PCT=0.0
ANALYZER_WINDOW_CANDLES=100

# ── Replay report ────────────────────────────────────────────────
# Used by analyzer-replay when --symbol / --init-fund are omitted.
BENCHMARK_TICKERS=BTC-USDT,ETH-USDT,SOL-USDT
BENCHMARK_INIT_FUND=1000

# ── Live ─────────────────────────────────────────────────────────
GRPC_TRADE_ENGINE_ENDPOINT=http://127.0.0.1:50051
LIVE_SYMBOLS=BTC-USDT,ETH-USDT
ANALYZER_ACTIVATION_POLL_MS=30000
ANALYZER_CANDLE_SETTLE_MS=5000
ANALYZER_POLL_INTERVAL_MS=1000
KUCOIN_BASE_URL=https://api.kucoin.com
ANALYZER_ONCE=0
