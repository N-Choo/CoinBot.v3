# ── Strategy (same names as the Python analyzer) ─────────────────
KUCOIN_TIMEFRAME=15min
RSI_PERIOD=14
RSI_DIVERGENCE_ORDER=5
PRICE_DIFF_THRESHOLD=0.05
SMA_ENABLED=false
SMA_PERIOD=20
ATR_PERIOD=14
ATR_SL_MULTIPLIER=2.0
ATR_TP_MULTIPLIER=3.0
ATR_PCT_HIGH=5.0
ATR_HIGH_ADJUST=1.5
ATR_SL_MAX_PCT=0.0
ANALYZER_WINDOW_CANDLES=100
# Optional: suppress signals older than N candles (empty = parity, no cap)
ANALYZER_MAX_DIVERGENCE_AGE_CANDLES=

# ── Live ─────────────────────────────────────────────────────────
GRPC_TRADE_ENGINE_ENDPOINT=http://127.0.0.1:50051
LIVE_SYMBOLS=BTC-USDT,ETH-USDT
ANALYZER_ACTIVATION_POLL_MS=30000
ANALYZER_CANDLE_SETTLE_MS=5000
ANALYZER_POLL_INTERVAL_MS=1000
KUCOIN_BASE_URL=https://api.kucoin.com
ANALYZER_ONCE=0
