# ============================================
# CoinBot CI environment
# Used by .github/workflows/_smoke-test.yml.
# ============================================

# -- PostgreSQL ----------------------------------
DATABASE_URL=postgres://test:ci-test-postgres-password@postgres:5432/coinbot_test
POSTGRES_DB=coinbot_test
POSTGRES_PASSWORD=ci-test-postgres-password
POSTGRES_USER=test

# -- Redis ---------------------------------------
REDIS_PASSWORD=ci-test-redis-password
REDIS_URL=redis://:ci-test-redis-password@redis:6379

# -- gRPC (internal services) --------------------
GRPC_ADDR=0.0.0.0:50051
GRPC_AUTH_TOKEN=ci-test-service-token
GRPC_DEPOSIT_ENDPOINT=http://deposit-worker:50051
GRPC_TIMEOUT_SECS=10
GRPC_TRADE_ENGINE_ENDPOINT=http://trade-engine:50051

# -- Logging -------------------------------------
RUST_LOG=info

# -- API gateway ---------------------------------
API_GATEWAY_ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_N_QUEUE=100
API_GATEWAY_N_WORKER=4
API_GATEWAY_PORT=8080

# -- KuCoin (test values) ------------------------
KC_KEY=ci-test-key
KC_PASSPHRASE=ci-test-passphrase
KC_SECRET=ci-test-secret
KUCOIN_BASE_URL=https://api.kucoin.com
WITHDRAW_KC_KEY=ci-test-key
WITHDRAW_KC_PASSPHRASE=ci-test-passphrase
WITHDRAW_KC_SECRET=ci-test-secret

# -- Ethereum deposits ---------------------------
ETH_CONFIRMATIONS=12
ETH_RPC_URLS=https://ethereum-rpc.publicnode.com

# -- opencode / trade-agent ----------------------
OPENCODE_AGENT=trade-agent
OPENCODE_BASE_URL=http://opencode:4096
OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash
OPENCODE_PASSWORD=ci-test-opencode-password
OPENCODE_SERVER_PASSWORD=ci-test-opencode-password
OPENCODE_TIMEOUT_SECS=180
OPENCODE_USERNAME=opencode

# -- signal-gateway ------------------------------
SIGNAL_GATEWAY_AUDIT_PATH=./state/audit.jsonl
SIGNAL_GATEWAY_CYCLE_DELAY_SECS=90
SIGNAL_GATEWAY_DELETE_SESSIONS=true
SIGNAL_GATEWAY_MAX_ENTRY_DRIFT_PCT=5
SIGNAL_GATEWAY_MIN_CONFIDENCE=0.55
SIGNAL_GATEWAY_PRICE_CHECK=strict
SIGNAL_GATEWAY_RESET_STATE=false
SIGNAL_GATEWAY_RUN_ON_START=false
SIGNAL_GATEWAY_SIGNAL_TTL_SECS=14400
SIGNAL_GATEWAY_STATE_PATH=./state/signal_gateway.json
